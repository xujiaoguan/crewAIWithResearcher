# Copy this file to .env and supply your own credentials.
# Select oneapi, openai, or ollama.
MODEL_TYPE=oneapi
PORT=8013

# OpenAI or an OpenAI-compatible service
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_CHAT_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# OneAPI gateway
ONEAPI_API_BASE=http://localhost:3000/v1
ONEAPI_CHAT_API_KEY=
ONEAPI_CHAT_MODEL=qwen-max-latest

# Local Ollama service
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_CHAT_API_KEY=ollama
OLLAMA_CHAT_MODEL=llama3.1:latest

# Optional: enable Serper search for the research agent.
SERPER_API_KEY=
